{
  "name": "ttgppsychmh-academic-website",
  "version": "1.0.0",
  "private": true,
  "description": "Build tooling for the personal academic website of Tran Thien Gia Phuoc",
  "repository": {
    "type": "git",
    "url": "https://github.com/ttgpPsychMH/ttgpPsychMH.github.io"
  },
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "dependencies": {
    "jquery": "^3.7.1",
    "plotly.js-dist-min": "^3.6.0"
  },
  "devDependencies": {
    "onchange": "^7.1.0",
    "uglify-js": "^3.19.3"
  },
  "scripts": {
    "uglify": "uglifyjs node_modules/jquery/dist/jquery.min.js assets/js/plugins/jquery.greedy-navigation.js assets/js/_main.js assets/js/theme.js -c -m -o assets/js/main.min.js",
    "watch:js": "onchange \"assets/js/**/*.js\" -e \"assets/js/main.min.js\" -- npm run build:js",
    "build:js": "npm run uglify"
  }
}
