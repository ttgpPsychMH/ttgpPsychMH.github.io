---
layout: none
permalink: /images/manifest.json
---
{
  "name": {{ site.title | jsonify }},
  "short_name": {{ site.name | jsonify }},
  "description": {{ site.description | jsonify }},
  "start_url": "{{ site.baseurl | default: '/' }}",
  "lang": {{ site.locale | default: "en" | jsonify }},
  "theme_color": "#9be5dc",
  "background_color": "#f8fcfb",
  "display": "browser",
  "icons": [
    {
      "src": "/images/favicon.svg",
      "sizes": "any",
      "type": "image/svg+xml",
      "purpose": "any"
    },
    {
      "src": "/images/favicon-192x192.png",
      "sizes": "192x192",
      "type": "image/png"
    },
    {
      "src": "/images/favicon-512x512.png",
      "sizes": "512x512",
      "type": "image/png"
    }
  ]
}
